@model InventoryManagement.Models.Product

<h2>Add New Product</h2>

@using (Html.BeginForm())
{
    <div>
        <label>Product Name</label>
        @Html.TextBoxFor(m => m.ProductName, new { required = "required" })
    </div>

    <br />

    <div>
        <label>Quantity</label>
        @Html.TextBoxFor(m => m.Quantity, new { type = "number", required = "required" })
    </div>

    <br />

    <div>
        <label>Price</label>
        @Html.TextBoxFor(m => m.Price, new { type = "number", step = "0.01", required = "required" })
    </div>

    <br />

    <button type="submit">Save Product</button>
}

<br />

@Html.ActionLink("Back to Inventory", "Index")
