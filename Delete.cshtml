@model InventoryManagement.Models.Product

<h2>Delete Product</h2>

<h3>Are you sure you want to delete this product?</h3>

<div>
    <p><strong>Product ID:</strong> @Model.ProductId</p>
    <p><strong>Product Name:</strong> @Model.ProductName</p>
    <p><strong>Quantity:</strong> @Model.Quantity</p>
    <p><strong>Price:</strong> @Model.Price</p>
</div>

@using (Html.BeginForm())
{
    @Html.HiddenFor(m => m.ProductId)

    <button type="submit">Confirm Delete</button>
}

<br />

@Html.ActionLink("Back to Inventory", "Index")
